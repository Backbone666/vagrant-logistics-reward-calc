{
	"name": "vagrant-logistics-reward-calc",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "node dev.js",
		"test": "node --test test/calculator.test.js test/route-service.test.js test/system-autocomplete.test.js",
		"test:coverage": "node --experimental-test-coverage --test test/calculator.test.js test/route-service.test.js test/system-autocomplete.test.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"build:highsec": "node scripts/build-highsec-data.mjs",
		"check": "npm run lint && npm test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14"
	}
}
